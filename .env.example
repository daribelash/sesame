DATABASE_URL=postgres://user:password@localhost:5432/sesame
PORT=3000

# Maps JavaScript API key, restricted by HTTP referrer in the GCP Console.
# Vite inlines VITE_-prefixed vars into the client bundle, so this key is
# not secret once shipped — the referrer restriction is the real boundary.
# Also used for address autocomplete suggestions on the add-gate form, which
# needs the Places API enabled on the same GCP project (separate quota/cost
# from the Maps JavaScript API used for the map view).
VITE_GOOGLE_MAPS_API_KEY=your-api-key-here

# Optional — a Map ID from the GCP Console, required for Advanced Markers'
# custom pin content in production. Falls back to Google's public
# DEMO_MAP_ID (fine for local dev, not for production use) if unset.
VITE_GOOGLE_MAPS_MAP_ID=your-map-id-here
